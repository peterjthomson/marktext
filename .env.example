# Oh My Marktext — build environment configuration
# Copy this file to .env and fill in your values. .env is gitignored.
#
# None of this is needed for `pnpm dev` or for unsigned local builds — a local
# `pnpm build:mac` with no Developer ID in your keychain will simply skip
# signing and notarization with a warning.

# =============================================================================
# macOS code signing & notarization (local release builds)
# =============================================================================
# electron-builder reads these when `mac.notarize: true` in
# packages/desktop/electron-builder.yml.
#
# APPLE_APP_SPECIFIC_PASSWORD is generated at https://appleid.apple.com
# (Sign-In and Security -> App-Specific Passwords), NOT your Apple ID password.
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Skip notarization for a faster local build (set to any value to skip).
# CSC_IDENTITY_AUTO_DISCOVERY=false

# =============================================================================
# GitHub Actions (CI/CD) — configured as repository secrets, not in this file
# =============================================================================
# Settings -> Secrets and variables -> Actions:
#
#   MAC_CERTS                   Base64-encoded Developer ID Application .p12
#                               base64 -i cert.p12 | pbcopy
#   MAC_CERTS_PASSWORD          Password for the .p12
#   APPLE_ID                    Apple Developer account email
#   APPLE_APP_SPECIFIC_PASSWORD App-specific password (see above)
#   APPLE_TEAM_ID               Apple Developer Team ID
#
# The release workflow maps MAC_CERTS -> CSC_LINK and
# MAC_CERTS_PASSWORD -> CSC_KEY_PASSWORD, and fails fast if any are missing
# rather than publishing unsigned macOS artifacts.
#
# IMPORTANT: the signing certificate must be authorised for the appId in
# packages/desktop/electron-builder.yml (com.peterjthomson.ohmy-marktext).
# Never change the appId after users have installed — it silently orphans
# their preferences and breaks the update path.
